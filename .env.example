# ---- Camera streams (never commit real URLs) -------------------------------
# Camera inventory JSON of your state DOT's CCTV program (Caltrans district
# status format), used by src/triage/scan_cameras.py.
CCTV_INVENTORY_URL=

# Comma-separated camera specs: <camera_id>|<stream_url>
# Find public streams on your state DOT camera site (e.g. Caltrans District 4 map).
CAMERA_STREAMS=cam_example_01|https://example.invalid/stream1.m3u8,cam_example_02|https://example.invalid/stream2.m3u8

# ---- Kafka / Schema Registry ------------------------------------------------
# Local (docker compose) defaults:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Confluent Cloud (live path) — leave blank for local runs:
CONFLUENT_BOOTSTRAP_SERVERS=
CONFLUENT_API_KEY=
CONFLUENT_API_SECRET=
CONFLUENT_SR_URL=
CONFLUENT_SR_API_KEY=
CONFLUENT_SR_API_SECRET=

# ---- Topics ------------------------------------------------------------------
TOPIC_VEHICLE_EVENTS=vehicle.events
TOPIC_TRAFFIC_ALERTS=traffic.alerts

# ---- Perception ---------------------------------------------------------------
YOLO_MODEL=yolo11n.pt
YOLO_DEVICE=auto            # auto | cpu | mps | cuda
CONFIDENCE_THRESHOLD=0.35

# ---- GCP (live path only) ------------------------------------------------------
GCP_PROJECT_ID=
GCP_ZONE=us-west1-b
